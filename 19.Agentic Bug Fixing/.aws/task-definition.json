{
  "family": "agentic-bug-fixing-task",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::<AWS_ACCOUNT_ID>:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::<AWS_ACCOUNT_ID>:role/agenticBugFixingTaskRole",
  "containerDefinitions": [
    {
      "name": "agentic-bug-fixing",
      "image": "<AWS_ACCOUNT_ID>.dkr.ecr.us-west-2.amazonaws.com/agentic-bug-fixing:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 7860,
          "hostPort": 7860,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "OPENAI_MODEL",
          "value": "gpt-4o-mini"
        },
        {
          "name": "MAX_FIX_ATTEMPTS",
          "value": "3"
        },
        {
          "name": "GRADIO_SERVER_NAME",
          "value": "0.0.0.0"
        },
        {
          "name": "GRADIO_SERVER_PORT",
          "value": "7860"
        }
      ],
      "secrets": [
        {
          "name": "OPENAI_API_KEY",
          "valueFrom": "arn:aws:secretsmanager:us-west-2:<AWS_ACCOUNT_ID>:secret:agentic-bug-fixing/openai-REPLACE"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/agentic-bug-fixing",
          "awslogs-region": "us-west-2",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}